# sass-blog — edge de dominios propios + TLS automático (ADR-020)
#
# Caddy termina TLS para los dominios de los tenants con `on_demand_tls`: ante un SNI
# desconocido pregunta primero al backend (ask-endpoint) si el dominio está VERIFICADO
# (active); sólo entonces obtiene un certificado Let's Encrypt on-demand y proxya al
# renderer Nuxt PRESERVANDO el Host (el renderer resuelve el sitio por Host).
#
# El gate en el ask-endpoint es la pieza de seguridad: nunca se emite un cert para un SNI
# arbitrario (evita hijacking y los rate-limits de Let's Encrypt).
#
# Variables de entorno (ver README):
#   ACME_EMAIL         correo de la cuenta ACME (Let's Encrypt)
#   TLS_ASK_URL        p.ej. http://backend:8000/api/v1/public/domains/tls-check
#   RENDERER_UPSTREAM  p.ej. renderer:3000
#   PLATFORM_HOST      host propio de la plataforma servido por el renderer (opcional)

{
	email {$ACME_EMAIL}

	# Sólo emitir cert si el backend responde 2xx (dominio verificado). Caddy añade
	# ?domain=<sni> a esta URL automáticamente.
	on_demand_tls {
		ask {$TLS_ASK_URL}
		interval 2m
		burst 5
	}
}

# --- Dominios propios de tenants (blog.acme.com, acme.com, …) -----------------
# Bloque catch-all HTTPS: TLS on-demand gateado por el ask-endpoint + proxy al renderer.
# Caddy preserva el Host entrante hacia el upstream; lo fijamos explícito por claridad.
https:// {
	tls {
		on_demand
	}

	reverse_proxy {$RENDERER_UPSTREAM} {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# --- Host propio de la plataforma (opcional) ----------------------------------
# El dominio de la plataforma usa un cert normal (es nuestro), sin on_demand. Se sirve el
# mismo renderer (modo _site/{ulid} para preview). El admin/API se despliegan aparte.
# {$PLATFORM_HOST} {
# 	reverse_proxy {$RENDERER_UPSTREAM} {
# 		header_up Host {host}
# 	}
# }
