{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "admin", "dev"],
      "port": 5173,
      "url": "http://127.0.0.1:5173"
    },
    {
      "name": "backend",
      "runtimeExecutable": "php",
      "runtimeArgs": ["backend/artisan", "serve", "--host=127.0.0.1", "--port=8000"],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    }
  ]
}
