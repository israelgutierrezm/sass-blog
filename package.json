{
  "name": "sass-blog",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma SaaS multitenant para crear, administrar, publicar y monetizar sitios web.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:admin": "pnpm --filter admin dev",
    "dev:renderer": "pnpm --filter renderer dev",
    "build:admin": "pnpm --filter admin build",
    "build:renderer": "pnpm --filter renderer build",
    "build:schema": "pnpm --filter @sass-blog/site-schema build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
